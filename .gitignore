*.db
*.sqlite
*.sqlite3
GestionDeStockAPP.db

# Logs
logs/
*.log

# Node modules (if using frontend tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.temp

# Docker
.docker/

