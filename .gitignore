bin/
obj/
*.dll
*.exe
*.pdb
*.user
*.suo
*.csproj.user

# IDE
.vs/
.vscode/
*.swp
*.swo
*~
.idea/

# Dependencies
packages/
.nuget/

# Environment
.env
.env.local
.env.*.local

